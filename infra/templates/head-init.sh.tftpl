#!/bin/bash
# Head node bring-up, run once by cloud-init after packages are installed.
# Progress: /var/log/ehpc-init.log. Done when /shared/.ready exists.
set -euxo pipefail
install -m 0600 /dev/null /var/log/ehpc-init.log
exec > >(tee -a /var/log/ehpc-init.log) 2>&1

region="${region}"
cluster="${cluster_name}"
param_root="${munge_param_root}"

# 0. The agent's egress rules were loaded by bootcmd; refuse to go on
#    without them (agent-egress.nft).
nft list table inet ehpc_agent >/dev/null 2>&1 || nft -f /etc/ehpc/agent-egress.nft
nft list table inet ehpc_agent >/dev/null

# 1. Shared filesystem: every node mounts /shared, so job workdirs, the
#    Python environment and model weights exist once.
install -d -m 1777 /shared/scratch /shared/data /shared/results
install -d -o agent -g agent /shared/scratch/agent
systemctl enable --now nfs-server
exportfs -ra

# 2. The agent's allowlisting proxy (squid.conf).
install -m 0644 /etc/ehpc/squid.conf /etc/squid/squid.conf
squid -k parse
systemctl enable squid
systemctl restart squid

# 3. AWS CLI (not in the Ubuntu 24.04 archive).
snap wait system seed.loaded
snap install aws-cli --classic
aws() { /snap/bin/aws --region "$region" "$@"; }

# 4. Cluster key. A fresh munge key, published to SSM Parameter Store as a
#    SecureString under this instance's ID; compute nodes read it with their
#    own instance role. Keys left by earlier clusters are deleted.
set +x # never trace the IMDS session token
token=$(curl -fsS -X PUT http://169.254.169.254/latest/api/token -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
instance_id=$(curl -fsS -H "X-aws-ec2-metadata-token: $token" http://169.254.169.254/latest/meta-data/instance-id)
unset token
set -x
for stale in $(aws ssm get-parameters-by-path --path "$param_root" --query 'Parameters[].Name' --output text); do
  [[ "$stale" == "$param_root/$instance_id" ]] || aws ssm delete-parameter --name "$stale"
done
head -c 1024 /dev/urandom > /etc/munge/munge.key
chown munge:munge /etc/munge/munge.key
chmod 0400 /etc/munge/munge.key
systemctl restart munge
keyfile=$(mktemp)
base64 -w0 /etc/munge/munge.key > "$keyfile"
aws ssm put-parameter --name "$param_root/$instance_id" --type SecureString --overwrite \
  --value "file://$keyfile" --query Version --output text
rm -f "$keyfile"

# 5. Job accounting: slurmdbd on a local MariaDB, so sacct works. The
#    database password is generated here and never leaves this node.
systemctl enable --now mariadb
set +x # never trace the password
dbpass=$(openssl rand -hex 24)
mysql <<SQL
CREATE DATABASE IF NOT EXISTS slurm_acct_db;
CREATE USER IF NOT EXISTS 'slurm'@'localhost' IDENTIFIED BY '$dbpass';
ALTER USER 'slurm'@'localhost' IDENTIFIED BY '$dbpass';
GRANT ALL ON slurm_acct_db.* TO 'slurm'@'localhost';
SQL
install -d -o slurm -g slurm /var/log/slurm /var/spool/slurmctld
install -o slurm -g slurm -m 0600 /dev/null /etc/slurm/slurmdbd.conf
cat > /etc/slurm/slurmdbd.conf <<CONF
AuthType=auth/munge
DbdHost=head
SlurmUser=slurm
StorageType=accounting_storage/mysql
StorageHost=localhost
StorageUser=slurm
StoragePass=$dbpass
StorageLoc=slurm_acct_db
LogFile=/var/log/slurm/slurmdbd.log
PidFile=/run/slurmdbd/slurmdbd.pid
CONF
unset dbpass
set -x
systemctl enable slurmdbd
systemctl restart slurmdbd
for _ in $(seq 30); do sacctmgr -n list cluster >/dev/null 2>&1 && break; sleep 2; done
sacctmgr -i add cluster "$cluster" || true

systemctl enable slurmctld
systemctl restart slurmctld

# 6. The workload runtime: an Apptainer image holding Python, the pinned
#    packages and the ESM-2 weights (docs/adr/0007-apptainer.md). Jobs run
#    inside it; the hosts get no Python packages. Built as root from the
#    definition in the repo; the agent can run it but not change it.
curl -fsSLo /tmp/apptainer.deb "${apptainer_url}"
echo "${apptainer_sha256}  /tmp/apptainer.deb" | sha256sum -c -
# Unattended upgrades may hold the dpkg lock this early in boot.
DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=600 install -y -q /tmp/apptainer.deb
rm -f /tmp/apptainer.deb
# The .deb depends on uidmap, whose setuid newuidmap/newgidmap let users
# map into subordinate UIDs. Root's image build does not need them.
dpkg-statoverride --update --add root root 0755 /usr/bin/newuidmap
dpkg-statoverride --update --add root root 0755 /usr/bin/newgidmap
# Not `! grep`: set -e ignores negated commands, so that would never fail.
if grep -qs '^agent:' /etc/subuid /etc/subgid; then
  echo 'agent has subordinate IDs' >&2
  exit 1
fi
install -d -m 0755 /shared/containers
cd /shared/opt/ehpc/workloads
apptainer build --force /shared/containers/esm.sif container/esm.def \
  > /var/log/ehpc-apptainer-build.log 2>&1
cd /
chmod 0644 /shared/containers/esm.sif
sha256sum /shared/containers/esm.sif | tee /shared/containers/esm.sif.sha256

# 7. The dataset, fetched once so agent jobs start from the same sample.
sudo -u ubuntu python3 /shared/opt/ehpc/workloads/protein/fetch_uniprot.py

nft list table inet ehpc_agent >/dev/null # still in place after package installs
touch /shared/.ready
echo "ehpc head ready: $(date -Is)"
