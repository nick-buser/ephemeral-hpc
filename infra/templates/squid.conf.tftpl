# Allowlisting forward proxy for the agent user, on the head node. Only
# cluster addresses may use it, only for the domains below, and HTTPS only
# via CONNECT to port 443. Every request lands in access.log.
http_port 3128
acl cluster src ${vpc_cidr}
acl allowed dstdomain ${join(" ", allowlist)}
acl SSL_ports port 443
acl Safe_ports port 80 443
acl CONNECT method CONNECT
http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports
http_access allow cluster allowed
http_access deny all
cache deny all
access_log daemon:/var/log/squid/access.log squid
via off
forwarded_for delete
