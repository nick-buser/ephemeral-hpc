#cloud-config
hostname: ${node_name}
preserve_hostname: false
manage_etc_hosts: false
bootcmd:
  - [sh, -c, "echo ${base64encode(agent_egress_nft)} | base64 -d | nft -f -"]
users:
  - default
  - name: agent
    uid: "${agent_uid}"
    shell: /bin/bash
    lock_passwd: true
package_update: true
packages:
  - munge
  - slurmd
  - slurm-client
  - nfs-common
write_files:
  - path: /etc/hosts
    encoding: b64
    content: ${base64encode(hosts_file)}
  - path: /etc/default/slurmd
    encoding: b64
    content: ${base64encode("SLURMD_OPTIONS=\"--conf-server head\"\n")}
  - path: /etc/profile.d/ehpc.sh
    encoding: b64
    content: ${base64encode(profile_env)}
  - path: /etc/ehpc/agent-egress.nft
    encoding: b64
    content: ${base64encode(agent_egress_nft)}
  - path: /usr/local/sbin/ehpc-compute-init
    permissions: "0700"
    encoding: b64
    content: ${base64encode(init_script)}
runcmd:
  - [shutdown, -h, "+${ttl_minutes}"]
  - [/usr/local/sbin/ehpc-compute-init]
