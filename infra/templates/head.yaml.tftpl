#cloud-config
# File bodies are base64 so YAML indentation can never corrupt them.
hostname: head
preserve_hostname: false
manage_etc_hosts: false
package_update: true
packages:
  - munge
  - slurmctld
  - slurmdbd
  - slurm-client
  - mariadb-server
  - nfs-kernel-server
  - python3-venv
write_files:
  - path: /etc/hosts
    encoding: b64
    content: ${base64encode(hosts_file)}
  - path: /etc/slurm/slurm.conf
    encoding: b64
    content: ${base64encode(slurm_conf)}
  - path: /etc/slurm/cgroup.conf
    encoding: b64
    content: ${base64encode(cgroup_conf)}
  - path: /etc/exports
    encoding: b64
    content: ${base64encode("/shared ${vpc_cidr}(rw,sync,no_subtree_check)\n")}
  - path: /etc/profile.d/ehpc.sh
    encoding: b64
    content: ${base64encode(profile_env)}
  - path: /usr/local/sbin/ehpc-head-init
    permissions: "0700"
    encoding: b64
    content: ${base64encode(init_script)}
%{ for path, gz in workload_files ~}
  - path: /shared/opt/ehpc/workloads/${path}
    permissions: "0755"
    encoding: gz+b64
    defer: true
    content: ${gz}
%{ endfor ~}
runcmd:
  - [shutdown, -h, "+${ttl_minutes}"]
  - [/usr/local/sbin/ehpc-head-init]
