#cloud-config
# File bodies are base64 so YAML indentation can never corrupt them.
hostname: head
preserve_hostname: false
manage_etc_hosts: false
# Agent egress rules go in before users exist, so there is no window in
# which the agent can log in unfiltered.
bootcmd:
  - [sh, -c, "echo ${base64encode(agent_egress_nft)} | base64 -d | nft -f -"]
users:
  - default
  - name: agent
    uid: "${agent_uid}"
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ${agent_ssh_public_key}
package_update: true
packages:
  - squid
  - munge
  - slurmctld
  - slurmdbd
  - slurm-client
  - mariadb-server
  - nfs-kernel-server
  - python3-venv
write_files:
  - path: /etc/hosts
    encoding: b64
    content: ${base64encode(hosts_file)}
  - path: /etc/slurm/slurm.conf
    encoding: b64
    content: ${base64encode(slurm_conf)}
  - path: /etc/slurm/cgroup.conf
    encoding: b64
    content: ${base64encode(cgroup_conf)}
  - path: /etc/exports
    encoding: b64
    content: ${base64encode("/shared ${vpc_cidr}(rw,sync,no_subtree_check)\n")}
  - path: /etc/profile.d/ehpc.sh
    encoding: b64
    content: ${base64encode(profile_env)}
  - path: /etc/ehpc/agent-egress.nft
    encoding: b64
    content: ${base64encode(agent_egress_nft)}
  - path: /etc/ehpc/squid.conf
    encoding: b64
    content: ${base64encode(squid_conf)}
  - path: /usr/local/sbin/ehpc-head-init
    permissions: "0700"
    encoding: b64
    content: ${base64encode(init_script)}
  - path: /shared/opt/ehpc/bin/esm-python
    permissions: "0755"
    encoding: b64
    defer: true
    content: ${base64encode(esm_python)}
%{ for path, body in workload_files ~}
  - path: /shared/opt/ehpc/workloads/${path}
    permissions: "0755"
    defer: true
    content: |
      ${indent(6, body)}
%{ endfor ~}
runcmd:
  - [shutdown, -h, "+${ttl_minutes}"]
  - [/usr/local/sbin/ehpc-head-init]
