# Terraform working state and anything that can hold secrets or account IDs
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
*.auto.tfvars
terraform.tfvars
override.tf
override.tf.json
*_override.tf

# Operator-local settings (ssh aliases, emails, IPs)
.operator.env
*.local.env

# Keys and generated ssh config
*.pem
*_ed25519
*_ed25519.pub
ssh_config.generated

# Python
__pycache__/
.venv/
.pytest_cache/
.ruff_cache/

# Workload outputs land under results/ only when curated
workloads/**/out/
*.npy
